# Puttipeli server environment (DESIGN §14.5, packages/server/src/config.ts). Every variable is optional and has the
# default shown; there are no secrets. The server reads process.env only (no dotenv): export the values in your shell,
# set them in the hosting platform (fly.toml / render.yaml), or pass this file to Docker with `--env-file .env`.
# Malformed values (non-integer, out of range, unknown log level) make the server exit at boot instead of defaulting.

# TCP port and bind address of the single HTTP + WebSocket listener.
PORT=8080
HOST=0.0.0.0

# Directory of the client build served as static files (SPA fallback to index.html). Default: packages/client/dist
# relative to the server bundle. A missing directory or an explicit empty value disables static serving, leaving only
# /healthz, /api/stats and /ws (this is the normal `npm run dev` situation, where Vite serves the client on 5173).
#PUBLIC_DIR=/app/packages/client/dist

# Comma-separated list of allowed `Origin` values for WebSocket upgrades (scheme://host[:port], no trailing slash).
# Unset = any origin is accepted (development). Set it to the public URL in production.
#PUBLIC_ORIGIN=https://puttipeli.fly.dev

# Capacity limits. A room creation beyond MAX_ROOMS is answered with the WebSocket error SERVER_FULL; a WebSocket
# upgrade beyond MAX_CONNECTIONS is rejected with HTTP 503.
MAX_ROOMS=200
MAX_CONNECTIONS=1000

# Room lifetime: removed after this many minutes without activity, or this many seconds with no connections at all.
ROOM_IDLE_TTL_MIN=90
ROOM_EMPTY_TTL_SEC=120

# debug | info | warn | error
LOG_LEVEL=info

# true = take the client IP from X-Forwarded-For (logging only; set behind Fly.io / Render / any reverse proxy).
TRUST_PROXY=false

# Build identifier reported by /api/stats and in the WebSocket `welcome`. The client bundle bakes it in at build time
# (BUILD_ID=... npm run build / docker build --build-arg BUILD_ID=...); the server reads it at run time, so set the same
# value in both places (the Dockerfile does this for you). Default "dev".
#BUILD_ID=dev
